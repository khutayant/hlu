# app
NAME="Heartland Union"
PORT="3300"
BASE="hlu"
APP_ENV="dev"

# database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hlu"

# storage (HLU/dir — uploads + temps)
STORAGE_DIR="../dir"
TEMP_DIR="../dir/temps"

# keycloak
KEYCLOAK_URL="http://localhost:3100"
KEYCLOAK_REALM="hlu"
KEYCLOAK_CLIENT_ID="hlu-server"
KEYCLOAK_CLIENT_SECRET="hlu-server-dev-secret"
KEYCLOAK_REDIRECT_URIS="http://localhost:5192/ui/hluwork/auth/callback,http://localhost:5191/ui/hlu/auth/callback"

# allows
ALLOW_ORIGINS="http://localhost:3300, http://localhost:5191, http://localhost:5192"
ALLOW_METHODS="GET, POST, PATCH, DELETE"
ALLOW_HEADERS="Content-Type, Authorization"
